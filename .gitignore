# Build output. Everything here is reproducible from source; `make clean` drops
# it, and build/raylib/ holds the vendored raylib fetched on first build.
/build/
/dist/

# Debug-run artifacts: screenshots and reports are written relative to the
# working directory, so runs must happen in a scratch directory, never the
# repository root.
#
# Exception: a handful of captures are cited as acceptance evidence by docs/
# and todo/. Those specific files ARE tracked, because evidence that exists
# only on the author's disk cannot be checked by anyone else. New captures are
# ignored by default; add a narrow !-rule when a document starts citing one.
/screenshots/*
!/screenshots/voxelcraft_20260819_011320_000.png
!/screenshots/voxelcraft_20260819_011320_000.txt
!/screenshots/voxelcraft_20260819_011348_000.png
!/screenshots/voxelcraft_20260819_011348_000.txt
!/screenshots/voxelcraft_20260819_073646_000.png
!/screenshots/voxelcraft_20260819_073646_000.txt
!/screenshots/voxelcraft_20260819_073654_000.png
!/screenshots/voxelcraft_20260819_073654_000.txt
!/screenshots/voxelcraft_20260819_073952_000.png
!/screenshots/voxelcraft_20260819_073952_000.txt
!/screenshots/voxelcraft_20260819_085223_000.png
!/screenshots/voxelcraft_20260819_085223_000.txt
!/screenshots/voxelcraft_20260819_094954_000.png
!/screenshots/voxelcraft_20260819_094954_000.txt
/debug-traces/
/.cubetest/

# Stray binaries from manual experiments at the repository root.
/voxelcraft
/rlgl_test

# Session state written when the game runs from the repository root. These are
# local player data and must never be committed.
/voxelcraft_save.txt
/voxelcraft_save.bak
/voxelcraft_settings.cfg
/voxelcraft_settings.cfg.bak

# Test binaries are generated from tests/*.c and share the source prefix. The
# negations re-admit every non-binary file that shares it: sources and scripts,
# plus the input lists a check reads (the declaration allowlist is a `.txt`, and
# leaving it out made `make test-declarations` fail in a fresh clone).
/tests/benchmark_chunks
/tests/test_*
!/tests/test_*.c
!/tests/test_*.h
!/tests/test_*.sh
!/tests/test_*.py
!/tests/test_*.txt
!/tests/test_*.json
!/tests/test_*.dsl
__pycache__/

*.o
*.a

# Local tooling configuration and scratch copies.
/.claude/
/.agents/
/.codex/
/.review-head/
node_modules/
